# SPDX-License-Identifier: AGPL-3.0-only
# Settings for `allstill serve`; `allstill serve -h` explains each.

# The address people use to reach Allstill. Passkeys belong to its host name,
# so set it before anyone makes one.
#ALLSTILL_BASE_URL=https://allstill.example.com

# Where to listen. Put a reverse proxy with TLS in front.
#ALLSTILL_LISTEN=127.0.0.1:8000

ALLSTILL_DB=/var/lib/allstill/allstill.db

# How much history each check keeps.
#ALLSTILL_KEEP_RUNS=1000
#ALLSTILL_KEEP_OUTPUT=100

# Email, through an SMTP server you have. Test it with
# `sudo allstill admin test-email -env-file /etc/allstill/allstill.env -to you@example.com`.
#ALLSTILL_SMTP_HOST=smtp.example.com
#ALLSTILL_SMTP_PORT=587
#ALLSTILL_SMTP_SECURITY=starttls
#ALLSTILL_SMTP_USERNAME=allstill@example.com
#ALLSTILL_SMTP_PASSWORD=
#ALLSTILL_SMTP_PASSWORD_FILE=
#ALLSTILL_SMTP_FROM=Allstill <allstill@example.com>
#ALLSTILL_SMTP_CA_FILE=
